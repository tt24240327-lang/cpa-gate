<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>맞춤 견적 비교 서비스</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Alpine.js for lightweight interactivity -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Pretendard', 'sans-serif'],
                    },
                    colors: {
                        primary: '#2563EB', // Blue-600
                        secondary: '#1D4ED8', // Blue-700
                        accent: '#F59E0B', // Amber-500
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #F3F4F6;
        }

        /* Smooth transitions */
        .fade-enter,
        .fade-leave-to {
            opacity: 0;
            transform: translateY(10px);
        }

        .fade-enter-active,
        .fade-leave-active {
            transition: all 0.3s ease;
        }

        /* Custom radio buttons */
        .option-card {
            transition: all 0.2s ease-in-out;
            border: 2px solid transparent;
        }

        .option-card:hover {
            border-color: #93C5FD;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        /* Loading spinner */
        .loader {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3B82F6;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* Glassmorphism Header */
        .glass-header {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(229, 231, 235, 0.5);
        }
    </style>
</head>

<body class="text-gray-800 antialiased min-h-screen flex flex-col items-center">

    <!-- x-data holds the state for our app -->
    <div x-data="quoteApp()"
        class="w-full max-w-5xl md:mt-10 md:mb-10 bg-white min-h-screen md:min-h-[800px] md:rounded-3xl shadow-2xl relative overflow-hidden flex flex-col mx-auto">

        <!-- Top Navigation Bar -->
        <header class="glass-header sticky top-0 z-50 px-5 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2 cursor-pointer" @click="reset()">
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-primary">
                    <i class="fa-solid fa-house-chimney"></i>
                </div>
                <div>
                    <span class="font-bold text-lg tracking-tight">마이홈플래너</span>
                    <template x-if="region">
                        <span class="text-[10px] bg-blue-600 text-white px-1.5 py-0.5 rounded ml-1 font-bold"
                            x-text="region"></span>
                    </template>
                </div>
            </div>
            <!-- Progress Indicator Removed for Simplified Flow -->
        </header>

        <!-- Social Proof Notification Popup -->
        <div x-show="showNotification" x-transition:enter="transition ease-out duration-500"
            x-transition:enter-start="opacity-0 translate-y-10" x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-500" x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-10"
            class="fixed bottom-6 left-6 z-[100] bg-white/90 backdrop-blur shadow-2xl rounded-2xl p-4 border border-blue-100 flex items-center gap-4 max-w-sm pointer-events-none">
            <div
                class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center text-white shrink-0 animate-bounce">
                <i class="fa-solid fa-bell"></i>
            </div>
            <div>
                <p class="text-[11px] text-gray-400 font-medium" x-text="notificationTime"></p>
                <p class="text-xs font-bold text-gray-800" x-html="notificationMsg"></p>
            </div>
        </div>

        <main class="flex-grow flex flex-col relative px-5 pt-6 pb-20">

            <!-- ==========================================
           STEP 0: Home / Category Selection
           ========================================== -->
            <div x-show="step === 0" x-transition.opacity.duration.300ms class="flex-grow flex flex-col">
                <div class="mb-8 mt-2">
                    <span
                        class="inline-block py-1 px-3 rounded-full bg-blue-50 text-primary text-sm font-semibold mb-3 border border-blue-100">
                        <i class="fa-solid fa-bolt text-accent mr-1"></i> <span
                            x-text="region ? region + ' 지역' : '빅데이터'"></span> 분석 기반
                    </span>
                    <h1 class="text-2xl font-bold leading-snug mb-2">
                        <template x-if="region">
                            <span><span class="text-primary" x-text="region"></span> 최고의 전문가를<br>찾으시나요?</span>
                        </template>
                        <template x-if="!region">
                            <span>어떤 전문가의<br>도움이 필요하신가요?</span>
                        </template>
                    </h1>
                    <p class="text-gray-500 text-sm"
                        x-text="region ? region + ' 고객님들이 가장 선호하는 우수 업체를 매칭해드려요.' : '상황에 딱 맞는 상위 1% 우수 파트너를 찾아드려요.'">
                    </p>
                </div>

                <!-- Category Grid -->
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                    <!-- Item 1 -->
                    <button @click="selectCategory('moving')"
                        class="option-card bg-gray-50 rounded-2xl p-4 flex flex-col items-center justify-center gap-3 h-32 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-blue-500 opacity-0 group-hover:opacity-5 transition-opacity">
                        </div>
                        <div
                            class="w-12 h-12 rounded-full bg-blue-100 text-primary flex items-center justify-center text-xl shadow-sm">
                            <i class="fa-solid fa-truck-fast"></i>
                        </div>
                        <span class="font-semibold text-gray-700">이사</span>
                    </button>

                    <!-- Item 2 -->
                    <button @click="selectCategory('cleaning')"
                        class="option-card bg-gray-50 rounded-2xl p-4 flex flex-col items-center justify-center gap-3 h-32 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-teal-500 opacity-0 group-hover:opacity-5 transition-opacity">
                        </div>
                        <div
                            class="w-12 h-12 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xl shadow-sm">
                            <i class="fa-solid fa-broom"></i>
                        </div>
                        <span class="font-semibold text-gray-700">입주/이사 청소</span>
                    </button>

                    <!-- Item 3 -->
                    <button @click="selectCategory('leak')"
                        class="option-card bg-gray-50 rounded-2xl p-4 flex flex-col items-center justify-center gap-3 h-32 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-indigo-500 opacity-0 group-hover:opacity-5 transition-opacity">
                        </div>
                        <div
                            class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl shadow-sm">
                            <i class="fa-solid fa-droplet"></i>
                        </div>
                        <span class="font-semibold text-gray-700">배관 누수</span>
                    </button>

                    <!-- Item 4 -->
                    <button @click="selectCategory('welding')"
                        class="option-card bg-gray-50 rounded-2xl p-4 flex flex-col items-center justify-center gap-3 h-32 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-orange-500 opacity-0 group-hover:opacity-5 transition-opacity">
                        </div>
                        <div
                            class="w-12 h-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center text-xl shadow-sm">
                            <i class="fa-solid fa-fire-flame-curved"></i>
                        </div>
                        <span class="font-semibold text-gray-700">출장 용접</span>
                    </button>

                    <!-- Item 5 -->
                    <button @click="selectCategory('faucet')"
                        class="option-card bg-gray-50 rounded-2xl p-4 flex flex-col items-center justify-center gap-3 h-32 md:h-40 col-span-2 md:col-span-1 relative overflow-hidden group">
                        <div class="absolute inset-0 bg-cyan-500 opacity-0 group-hover:opacity-5 transition-opacity">
                        </div>
                        <div class="flex flex-col md:items-center gap-2">
                            <div
                                class="w-12 h-12 rounded-full bg-cyan-100 text-cyan-600 flex items-center justify-center text-xl shadow-sm mx-auto md:mx-0">
                                <i class="fa-solid fa-sink"></i>
                            </div>
                            <div class="text-center md:text-center text-left">
                                <span class="font-semibold text-gray-700 block">수전/싱크대 교체</span>
                                <span class="text-[10px] text-gray-400">당일 방문 가능한 기사님</span>
                            </div>
                        </div>
                    </button>
                </div>

                <!-- Trust badge -->
                <div
                    class="mt-auto pt-8 flex items-center justify-center gap-2 text-gray-400 text-xs text-center border-t border-gray-100">
                    <i class="fa-solid fa-shield-check"></i>
                    <span>월 평균 3만명이 비교 견적을 받고 있습니다</span>
                </div>
            </div>

            <!-- STEP 1 & 2 Removed (Direct Access) -->

            <!-- ==========================================
           STEP 3: Loading / Matching
           ========================================== -->
            <div x-show="step === 3" x-transition.opacity.duration.300ms
                class="flex-grow flex flex-col items-center justify-center text-center" style="display: none;">
                <div class="relative w-24 h-24 mb-6">
                    <div class="absolute inset-0 border-4 border-blue-100 rounded-full shadow-inner"></div>
                    <div
                        class="absolute inset-0 border-4 border-primary rounded-full border-t-transparent animate-spin shadow-lg">
                    </div>
                    <div class="absolute inset-0 flex items-center justify-center text-primary text-2xl">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                </div>
                <h2 class="text-xl font-bold mb-2">고객 맞춤 업체를 찾는 중...</h2>
                <div class="h-10">
                    <p class="text-blue-600 text-sm font-semibold animate-pulse" x-text="loadingStatus"></p>
                </div>

                <!-- Animated Progress Bar -->
                <div class="w-64 h-1.5 bg-gray-100 rounded-full mt-4 overflow-hidden">
                    <div class="h-full bg-primary transition-all duration-300"
                        :style="'width: ' + loadingProgress + '%'"></div>
                </div>

                <div class="mt-10 bg-gray-50 rounded-2xl px-6 py-4 border border-gray-100 flex items-center gap-3">
                    <div class="flex -space-x-2">
                        <div class="w-6 h-6 rounded-full bg-blue-400 border-2 border-white"></div>
                        <div class="w-6 h-6 rounded-full bg-teal-400 border-2 border-white"></div>
                        <div class="w-6 h-6 rounded-full bg-indigo-400 border-2 border-white"></div>
                    </div>
                    <p class="text-[11px] text-gray-500 font-medium">실시간 <span
                            class="text-indigo-600 font-bold">128명</span>이 이 서비스를 이용 중입니다</p>
                </div>
            </div>

            <!-- ==========================================
           STEP 4: Result (The CPA Offer)
           ========================================== -->
            <div x-show="step === 4" x-transition.opacity.duration.500ms class="flex-grow flex flex-col"
                style="display: none;">
                <div class="text-center mb-6 mt-4">
                    <div
                        class="w-16 h-16 bg-blue-100 text-primary rounded-full flex items-center justify-center text-3xl mx-auto mb-4 backdrop-blur-sm shadow-inner">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">업체 비교 리스트</h2>
                    <p class="text-gray-600 mb-6">고객님의 조건에 딱 맞는<br>우수 업체 <span x-text="matchedPartners.length"></span>곳을
                        찾았습니다.</p>

                    <!-- Sorting Tabs -->
                    <div
                        class="flex items-center justify-center gap-2 bg-gray-100 p-1 rounded-xl max-w-xs mx-auto mb-8">
                        <button @click="sortResults('score')"
                            :class="sortBy === 'score' ? 'bg-white text-primary shadow-sm' : 'text-gray-500 hover:text-gray-800'"
                            class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all">추천순</button>
                        <button @click="sortResults('rating')"
                            :class="sortBy === 'rating' ? 'bg-white text-primary shadow-sm' : 'text-gray-500 hover:text-gray-800'"
                            class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all">별점순</button>
                        <button @click="sortResults('reviews')"
                            :class="sortBy === 'reviews' ? 'bg-white text-primary shadow-sm' : 'text-gray-500 hover:text-gray-800'"
                            class="flex-1 py-1.5 text-xs font-bold rounded-lg transition-all">후기순</button>
                    </div>
                </div>

                <!-- Multiple Results List -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-10">
                    <template x-for="(partner, index) in matchedPartners" :key="index">
                        <div
                            class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden relative group hover:shadow-xl transition-all duration-300">

                            <!-- Recommendation Badge -->
                            <div x-show="index === 0"
                                class="absolute top-0 right-0 bg-primary text-white text-[10px] font-bold px-3 py-1 rounded-bl-xl shadow-md z-10 animate-pulse">
                                BEST 추천
                            </div>

                            <div class="p-6">
                                <div class="flex justify-between items-start mb-5">
                                    <div class="flex items-center gap-4">
                                        <!-- Unified Rank Circle -->
                                        <div class="w-12 h-12 min-w-[48px] rounded-xl bg-blue-50 text-primary flex items-center justify-center font-bold text-lg shadow-inner"
                                            x-text="index + 1">
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-xl text-gray-800 tracking-tight"
                                                x-text="partner.name"></h3>
                                            <div class="flex items-center gap-1 mt-0.5">
                                                <div class="flex text-yellow-400 text-[10px]">
                                                    <template x-for="i in 5">
                                                        <i class="fa-solid fa-star"></i>
                                                    </template>
                                                </div>
                                                <span class="text-xs font-bold text-gray-700 ml-1"
                                                    x-text="partner.rating"></span>
                                                <span class="text-[10px] text-gray-400"
                                                    x-text="'(' + partner.reviews + '+)'"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col items-end gap-1.5">
                                        <div
                                            class="px-3 py-1 bg-green-50 text-green-600 text-[10px] font-bold rounded-full border border-green-100 flex items-center gap-1 shadow-sm">
                                            <i class="fa-solid fa-bolt text-[8px]"></i>
                                            <span>무료견적</span>
                                        </div>
                                        <template x-if="index < 2">
                                            <div
                                                class="px-2 py-0.5 bg-red-50 text-red-500 text-[9px] font-bold rounded border border-red-100 animate-pulse shadow-sm">
                                                오늘 마감 임박
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <div
                                    class="space-y-2.5 mb-6 bg-gray-50 p-4 rounded-xl border border-gray-100 relative overflow-hidden">
                                    <!-- Exclusive Badge -->
                                    <div
                                        class="absolute -right-6 -top-2 bg-amber-100 text-amber-700 text-[8px] font-black px-8 py-1 rotate-12 uppercase tracking-tighter shadow-sm border-b border-amber-200">
                                        Exclusive</div>

                                    <div class="flex items-center gap-2 text-sm text-gray-600">
                                        <i class="fa-solid fa-check-circle text-blue-500 text-[10px]"></i>
                                        <p x-html="partner.desc1"></p>
                                    </div>
                                    <div class="flex items-center gap-2 text-sm text-gray-600">
                                        <i class="fa-solid fa-check-circle text-blue-500 text-[10px]"></i>
                                        <p x-text="partner.desc2"></p>
                                    </div>
                                </div>

                                <!-- Best Review Highlight -->
                                <div class="mb-6 px-1">
                                    <div class="bg-blue-50/50 rounded-lg p-3 relative border border-blue-100/30">
                                        <div
                                            class="absolute -top-1.5 left-4 w-3 h-3 bg-blue-50 rotate-45 border-l border-t border-blue-100/50">
                                        </div>
                                        <p class="text-[11px] text-gray-600 italic leading-relaxed">
                                            <i class="fa-solid fa-quote-left text-[8px] text-blue-300 mr-1"></i>
                                            <span
                                                x-text="partner.reviewHighlight || '친절한 상담과 꼼꼼한 서비스에 정말 만족했습니다!'"></span>
                                        </p>
                                    </div>
                                </div>

                                <a :href="partner.url"
                                    class="block w-full text-center py-4 bg-primary rounded-2xl font-bold text-white shadow-lg flex items-center justify-center gap-2 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl hover:brightness-110 active:scale-[0.97] group/btn">
                                    <span>해당 업체 무료 견적 받기</span>
                                    <i
                                        class="fa-solid fa-chevron-right text-xs transition-transform duration-300 group-hover/btn:translate-x-1"></i>
                                </a>
                            </div>
                        </div>
                    </template>
                </div> <!-- End List -->

                <button @click="reset()"
                    class="mt-8 mb-4 text-sm text-gray-400 hover:text-gray-600 underline text-center w-full">
                    조건 다시 선택하기
                </button>
            </div>

        </main>
    </div>

    <script>
        function quoteApp() {
            return {
                step: 0,
                region: '', // 추출된 지역명
                showNotification: false,
                notificationMsg: '',
                notificationTime: '',
                loadingStatus: '',
                loadingProgress: 0,
                sortBy: 'score', // score, rating, reviews
                selections: {
                    category: '',
                    q1: '',
                    q2: ''
                },
                matchedPartners: [],

                // Quiz data
                questions: {
                    moving: {
                        q1: "어디로 이사하시나요?",
                        o1: ["가정집 (아파트/빌라)", "원룸/소형 이사", "사무실/기업 이사"],
                        q2: "이사 예정 시기를 알려주세요.",
                        o2: ["1개월 이내", "2개월 이내", "3개월 이후"]
                    },
                    cleaning: {
                        q1: "어떤 청소가 필요하신가요?",
                        o1: ["입주 청소 (신축)", "이사 청소 (거주)", "사무실/상가 청소"],
                        q2: "거주하실 공간의 평수는?",
                        o2: ["10평 이하", "20평대", "30평 이상"]
                    },
                    leak: {
                        q1: "누수 증상은 어떤가요?",
                        o1: ["천장/벽지 젖음", "수도요금 급증", "아래층으로 물 샘"],
                        q2: "거주 형태가 어떻게 되나요?",
                        o2: ["아파트/공동주택", "빌라/다세대", "단독주택/상가"]
                    },
                    welding: {
                        q1: "어떤 용접이 필요하신가요?",
                        o1: ["배관/탱크 수리", "구조물 제작/보수", "기타 정밀 용접"],
                        q2: "작업 장소가 어디인가요?",
                        o2: ["실내/가정", "야외/현장", "고소/위험 지역"]
                    },
                    faucet: {
                        q1: "교체하실 품목은 무엇인가요?",
                        o1: ["주방 싱크대 수전", "욕실 세면대 수전", "샤워기/수도꼭지"],
                        q2: "원하시는 제품 스타일은?",
                        o2: ["가성비 실속형", "디자인 고급형", "모르겠음 (전문가 추천)"]
                    }
                },

                init() {
                    // 1. URL 파라미터에서 지역명 추출 (kwd, query 우선)
                    const params = new URLSearchParams(window.location.search);
                    const rawKwd = params.get('kwd') || params.get('query') || '';
                    if (rawKwd) {
                        // 지역명 패턴 (강남, 부산, 일산 등 2~4글자 + 공백/특수문자 조합 고려)
                        const regionMatch = rawKwd.match(/([가-힣]{2,4}(?:구|시|동|읍|면|리|군))|([가-힣]{2,4})/);
                        if (regionMatch) {
                            this.region = regionMatch[0];
                        }
                    }

                    // 2. 사회적 증거(알림) 루프 시작
                    this.startNotificationLoop();

                    // Restore state from sessionStorage if available
                    const saved = sessionStorage.getItem('MyHomePlannerState');
                    if (saved) {
                        try {
                            const data = JSON.parse(saved);
                            this.selections = data.selections;
                            this.matchedPartners = data.matchedPartners;
                        } catch (e) { }
                    }

                    // Handle Browser Back/Forward
                    window.addEventListener('popstate', (event) => {
                        if (event.state && typeof event.state.step !== 'undefined') {
                            this.step = event.state.step;
                        } else {
                            this.step = 0;
                        }
                    });

                    // Initial state
                    const initialStep = this.step;
                    history.replaceState({ step: initialStep, region: this.region }, '', '');
                },

                startNotificationLoop() {
                    const locations = ['강남구', '송파구', '수원시', '용인시', '일산', '분당', '부산 해운대', '대구 수성구', '인천 연수구', '관악구'];
                    const actions = ['포장이사', '입주청소', '누수탐지', '수전교체', '용접수리'];

                    const trigger = () => {
                        const randomLoc = locations[Math.floor(Math.random() * locations.length)];
                        const randomAction = actions[Math.floor(Math.random() * actions.length)];
                        this.notificationMsg = `방금 <b>[${randomLoc}]</b>에서 <b>${randomAction}</b> 견적 비교를 완료했습니다!`;
                        this.notificationTime = '실시간 매칭 현황';
                        this.showNotification = true;

                        setTimeout(() => {
                            this.showNotification = false;
                            setTimeout(trigger, 8000 + Math.random() * 10000); // 8~18초 간격
                        }, 4000);
                    };

                    setTimeout(trigger, 3000); // 첫 실행은 3초 뒤
                },

                saveState() {
                    sessionStorage.setItem('MyHomePlannerState', JSON.stringify({
                        step: this.step,
                        selections: this.selections,
                        matchedPartners: this.matchedPartners
                    }));
                },

                goToStep(nextStep) {
                    this.step = nextStep;
                    this.saveState();
                    history.pushState({ step: nextStep }, '', '');
                },

                replaceStep(nextStep) {
                    this.step = nextStep;
                    this.saveState();
                    history.replaceState({ step: nextStep }, '', '');
                },

                selectCategory(cat) {
                    this.selections.category = cat;
                    this.goToStep(3); // Loading screen
                    this.loadingProgress = 0;

                    const statuses = [
                        `${this.region || '전국'} 서비스 업체 데이터 조회 중...`,
                        `상위 1% 우수 업체 필터링 중...`,
                        `실시간 예약 가능 여부 대조 중...`,
                        `고객님을 위한 최저가 견적 매칭 완료!`
                    ];

                    let currentTask = 0;
                    const interval = setInterval(() => {
                        this.loadingStatus = statuses[currentTask];
                        this.loadingProgress += 25;
                        currentTask++;
                        if (currentTask >= statuses.length) {
                            clearInterval(interval);
                            setTimeout(() => {
                                this.matchedPartners = this.getMatches();
                                this.replaceStep(4); // Results screen
                            }, 500);
                        }
                    }, 800);
                },

                sortResults(type) {
                    this.sortBy = type;
                    const items = [...this.matchedPartners];
                    if (type === 'rating') {
                        items.sort((a, b) => parseFloat(b.rating) - parseFloat(a.rating));
                    } else if (type === 'reviews') {
                        items.sort((a, b) => parseInt(b.reviews.replace(',', '')) - parseInt(a.reviews.replace(',', '')));
                    } else {
                        // Default score sort (as provided by getMatches initially)
                        this.matchedPartners = this.getMatches();
                        return;
                    }
                    this.matchedPartners = items;
                },

                getMatches() {
                    const cat = this.selections.category;
                    let list = [];
                    if (cat === 'moving') {
                        list = [
                            { name: "모두이사", rating: "4.9", reviews: "2,130", desc1: "<b>국내 1위</b> 포장이사 플랫폼 최우수 인증", desc2: "파손 보험 가입 완료로 100% 안전 보장", url: "https://www.replyalba.co.kr/pt/I84cXCrjhG", reviewHighlight: "이사짐 하나하나 정성스럽게 포장해주셔서 너무 안심됐어요." },
                            { name: "다이사", rating: "4.8", reviews: "1,850", desc1: "<b>빅데이터 기반</b> 우수 이사업체 3곳 즉시 매칭", desc2: "허가증, 보험가입 내역 100% 투명 공개", url: "https://www.replyalba.co.kr/pt/EdQfml7QZD", reviewHighlight: "여러 업체 비교할 필요 없이 여기서 한 번에 해결했네요!" },
                            { name: "이사타임", rating: "4.7", reviews: "940", desc1: "전국 어디나 무료 방문 견적 서비스", desc2: "합리적인 비용 제안", url: "https://www.replyalba.co.kr/pt/Kti1P8kTZ1", reviewHighlight: "가격이 정말 합리적이고 추가 비용 요구가 없어 좋았습니다." },
                            { name: "서경석의 이사방", rating: "4.7", reviews: "1,240", desc1: "<b>브랜드 만족도 1위</b> 믿고 맡기는 이사 서비스", desc2: "투명한 견적 및 친철한 서비스 보장", url: "https://www.replyalba.co.kr/pt/Lrvab2hUbh", reviewHighlight: "이사방 이름값 하네요. 서비스 질이 확실히 다릅니다." },
                            { name: "포장이사 24번가", rating: "4.6", reviews: "1,150", desc1: "업계 최다 전국 네트워크 보유", desc2: "이사부터 입주청소까지 한 번에 해결", url: "https://www.replyalba.co.kr/pt/J4ZFAYbSAA", reviewHighlight: "네트워크가 넓어서 그런지 예약이 정말 빨랐어요." }
                        ];
                    } else if (cat === 'cleaning') {
                        list = [
                            { name: "24번가 입주청소", rating: "4.8", reviews: "1,520", desc1: "<b>살균 스팀/피톤치드</b> 기본 포함 풀서비스", desc2: "하자 체크리스트 꼼꼼한 확인", url: "https://www.replyalba.co.kr/pt/Wd8q3xIZnX", reviewHighlight: "창틀 구석구석까지 새집처럼 깨끗해져서 놀랐습니다." },
                            { name: "이사방 청소", rating: "4.7", reviews: "980", desc1: "<b>전문 장비 투입</b> 구석구석 정밀 청소", desc2: "친환경 세제 사용으로 안심", url: "https://www.replyalba.co.kr/pt/WwVCgW9E1R", reviewHighlight: "친환경 세제를 써서 그런지 청소 후 냄새가 전혀 없네요." },
                            { name: "새집느낌 청소전문업체", rating: "4.8", reviews: "760", desc1: "<b>입주청소 전문</b> 새집증후군 완벽 제거", desc2: "만족도 1위 서비스 보장", url: "https://www.replyalba.co.kr/pt/10Iwll13Zcb", reviewHighlight: "새집증후군 걱정했는데 피톤치드 서비스 덕분에 안심입니다." },
                            { name: "모두클린", rating: "4.7", reviews: "1,100", desc1: "전국 어디나 <b>빠른 방문</b> 및 견적", desc2: "정액 요금제로 투명한 가격", url: "https://www.replyalba.co.kr/pt/SxXSKKGDYP", reviewHighlight: "정찰제라 믿음이 가고 상담원분들이 정말 친절하세요." }
                        ];
                    } else if (cat === 'leak') {
                        list = [
                            { name: "착한환경", rating: "4.9", reviews: "450", desc1: "<b>첨단 장비</b> 누수 지점 100% 탐지", desc2: "당일 수리 및 철저한 A/S", url: "https://www.replyalba.co.kr/pt/11onnC2QmU3", reviewHighlight: "다른 데서 못 찾던 누수를 여기선 단번에 찾아내시네요!" },
                            { name: "뚫뚫배관", rating: "4.8", reviews: "320", desc1: "막힌 곳 <b>시원하게</b> 해결하는 배관 전문가", desc2: "합리적인 가격과 정직한 시공", url: "https://www.replyalba.co.kr/pt/GkVRvxfx1T", reviewHighlight: "정말 속 시원하게 뚫어주셨습니다. 설비 최고네요." }
                        ];
                    } else if (cat === 'faucet') {
                        list = [
                            { name: "베테랑 홈케어", rating: "4.9", reviews: "580", desc1: "<b>수전/변기 교체</b> 꼼꼼한 전문가 시공", desc2: "국산 정품 자재 사용 및 보증", url: "https://www.replyalba.co.kr/pt/FzYOdTzVNw", reviewHighlight: "손빨 빠르시고 마감 처리까지 너무 깔끔해서 감동입니다." }
                        ];
                    } else if (cat === 'welding') {
                        list = [
                            { name: "베테랑 용접", rating: "4.9", reviews: "210", desc1: "<b>국가 기술 자격</b> 보유 정밀 용접 전문가", desc2: "산업 현장 및 가정집 긴급 출동 가능", url: "https://www.replyalba.co.kr/pt/XpBx9dZ5aE", reviewHighlight: "용접 부위가 너무 매끄러워서 예술 작품 보는 줄 알았습니다." }
                        ];
                    }
                    return list;
                },

                reset() {
                    sessionStorage.removeItem('MyHomePlannerState');
                    this.step = 0;
                    this.selections = { category: '', q1: '', q2: '' };
                    this.matchedPartners = [];
                    // Reset history to home
                    history.pushState({ step: 0 }, '', window.location.pathname);
                }
            }
        }
    </script>
</body>

</html>